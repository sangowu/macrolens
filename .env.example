# Copy this file to .env and fill in your API keys

# Required: LLM provider
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding: local llama.cpp server (Qwen3-Embedding-0.6B) — no API key needed
# Start: llama-server -m <gguf> --embedding --pooling last -ngl 99 --port 8081

# Required: Reranker (DashScope)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Required: FRED macroeconomic data
FRED_API_KEY=your_fred_api_key_here

# Optional: SEC EDGAR (unauthenticated works but rate-limited)
# SEC_USER_AGENT=YourName yourname@example.com

# Optional: Langfuse LLM 可观测性（Cloud）。不配置则追踪完全 no-op，不影响运行。
# 在 https://cloud.langfuse.com 创建项目后获取 key：
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
